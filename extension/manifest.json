{
  "manifest_version": 3,
  "name": "skald",
  "version": "0.1.0",
  "description": "Read-aloud companion: live in-tab control bar, sentence highlighting, system voices or the skald daemon. Alt+R to read.",
  "browser_specific_settings": {
    "gecko": {
      "id": "skald@skald.local",
      "strict_min_version": "140.0"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "offscreen"
  ],
  "minimum_chrome_version": "116",
  "host_permissions": [
    "http://localhost:8000/*",
    "http://localhost:50000/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "skald \u2014 read aloud (Alt+R)",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "commands": {
    "read-aloud": {
      "suggested_key": {
        "default": "Alt+R"
      },
      "description": "Start or pause reading the page (or current selection)"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/*"
      ],
      "matches": [
        "<all_urls>"
      ],
      "use_extension_uri": true
    }
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}